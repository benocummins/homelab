# Copy to .env for local use, or enter these in Dockhand's environment for the stack.
# Real values never go in Git.

# Network (macvlan "lan" network)
RECYCLARR_PRIVATE_IP=CHANGE_ME      # a free address from your IP ledger
RECYCLARR_MAC=CHANGE_ME             # 02:dc: plus the four IP octets in hex

# Sonarr
SONARR_URL=http://CHANGE_ME:8989
SONARR_API_KEY=CHANGE_ME            # Sonarr > Settings > General

# Radarr
RADARR_URL=http://CHANGE_ME:7878
RADARR_API_KEY=CHANGE_ME            # Radarr > Settings > General